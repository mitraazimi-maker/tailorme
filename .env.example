# Postgres connection string
DATABASE_URL="postgresql://tailorme:tailorme@localhost:5432/tailorme"

# Public base URL, used for Stripe redirect URLs
APP_URL="http://localhost:3000"

# Payments: "simulate" (only when APP_URL is localhost; no money moves) or "stripe"
PAYMENTS_MODE="simulate"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Recurring monthly prices for the Club tiers: Starter A$29, Pro A$59, Busy A$149, Unlimited A$299.
STRIPE_STARTER_PRICE_ID=""
STRIPE_PRO_PRICE_ID=""
STRIPE_BUSY_PRICE_ID=""
STRIPE_UNLIMITED_PRICE_ID=""

# Optional: ABN Lookup web services GUID (https://abr.business.gov.au/Tools/WebServices).
# Without it, ABNs are checksum-validated and an admin marks them checked by hand.
ABN_LOOKUP_GUID=""

# Comma-separated emails that get admin access on sign-up
ADMIN_EMAILS=""

# Where job photos are stored on disk (keep outside /public)
UPLOAD_DIR="./uploads"

# Shared secret for /api/cron/notify (sends Club job alerts after the Plus head start)
CRON_SECRET=""
