// tailor me data model. See CLAUDE.md for the product rules this encodes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  TAILOR
  ADMIN
}

enum AbnStatus {
  UNCHECKED
  CHECKED
  FAILED
}

enum ClubStatus {
  NONE
  ACTIVE
  PAST_DUE
  CANCELED
}

// Club tiers (decided 9 Nov 2026): monthly jobs won, see src/lib/plans.ts.
// No unlimited plan: past the allowance, tailors buy extra jobs (ExtraJobsPurchase).
enum ClubTier {
  STARTER
  PRO
  BUSY
  STUDIO
}

enum PurchaseStatus {
  PENDING
  PAID
}

enum ReportStatus {
  OPEN
  DISMISSED
  WARNED
  SUSPENDED
}

enum JobStatus {
  OPEN
  BOOKED
  CANCELLED
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

enum BookingStatus {
  CONFIRMED
  COMPLETED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  phone        String?
  suburb       String?
  role         Role     @default(CUSTOMER)
  // "Remembers your fit": the customer's own measurements and fit notes,
  // shown to tailors they have booked.
  fitNotes     String?
  isSample     Boolean  @default(false)
  createdAt    DateTime @default(now())

  sessions   Session[]
  tailor     TailorProfile?
  jobs       Job[]
  bookings   Booking[]       @relation("CustomerBookings")
  reviews    Review[]
  myTailors  MyTailor[]
  reports    ConductReport[]
  fitRecords FitRecord[]
}

model Session {
  id        String   @id // sha256 of the cookie token
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TailorProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  slug            String    @unique
  businessName    String
  suburb          String
  bio             String    @default("")
  yearsExperience Int?
  languages       String[]
  categories      String[]
  comesToCustomer Boolean   @default(false)
  sameDay         Boolean   @default(false)
  // Pickup & delivery is the tailor's own service at their own price, paid to them
  // directly. tailor me only shows it and passes the request on.
  offersPickup    Boolean   @default(false)
  pickupFeeCents  Int?
  pickupRadiusKm  Int       @default(8)
  pickupNote      String?
  openingHours    String?
  shopAddress     String?

  abn           String?
  abnStatus     AbnStatus @default(UNCHECKED)
  abnCheckedAt  DateTime?
  abnEntityName String?

  clubStatus           ClubStatus @default(NONE)
  clubTier             ClubTier   @default(STARTER)
  stripeCustomerId     String?    @unique
  stripeSubscriptionId String?    @unique
  clubRenewsAt         DateTime?
  // First joined the Club; months before this carry no unused jobs.
  clubSince            DateTime?

  // Featured add-on, its own monthly subscription on any plan: featured in search,
  // 15-minute head start on new jobs, portfolio gallery. Max 3 per suburb.
  featuredStatus         ClubStatus @default(NONE)
  featuredSubscriptionId String?    @unique
  featuredRenewsAt       DateTime?

  // Set by an admin on an upheld report of arranging work outside tailor me.
  // While in the future the tailor is treated as not a Club member.
  suspendedUntil   DateTime?
  suspensionReason String?

  isSample  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  services Service[]
  quotes   Quote[]
  bookings Booking[]
  reviews  Review[]
  fans     MyTailor[]
  requests Job[]      @relation("RequestedTailor")
  portfolio PortfolioPhoto[]
  reports   ConductReport[]
  fitRecords FitRecord[]
  extraJobs  ExtraJobsPurchase[]
}

// Portfolio. Public on the tailor's profile while they have the Featured add-on.
model PortfolioPhoto {
  id         String        @id @default(cuid())
  tailorId   String
  storageKey String        @unique
  mime       String
  bytes      Int
  caption    String?
  createdAt  DateTime      @default(now())
  tailor     TailorProfile @relation(fields: [tailorId], references: [id], onDelete: Cascade)

  @@index([tailorId])
}

model Service {
  id         String        @id @default(cuid())
  tailorId   String
  name       String
  note       String?
  priceCents Int?
  priceText  String? // e.g. "+30%" when it isn't a fixed price
  sortOrder  Int           @default(0)
  tailor     TailorProfile @relation(fields: [tailorId], references: [id], onDelete: Cascade)

  @@index([tailorId])
}

model Job {
  id                String     @id @default(cuid())
  ref               String     @unique
  customerId        String
  garment           String
  work              String
  category          String
  description       String
  fitting           String?
  timing            String
  suburb            String
  status            JobStatus  @default(OPEN)
  requestedTailorId String?
  acknowledgedAt    DateTime
  // When standard Club members can see the job: 15 minutes after posting if a
  // Club Plus member matches it, otherwise straight away. Null on older jobs.
  openToAllAt       DateTime?
  // Standard Club members are alerted once openToAllAt passes (see /api/cron/notify).
  clubNotifiedAt    DateTime?
  // A rebook sent only to the customer's own tailor until they open it up.
  exclusive         Boolean    @default(false)
  // The customer would like the tailor to collect and return the garment.
  wantsPickup       Boolean    @default(false)
  isSample          Boolean    @default(false)
  createdAt         DateTime   @default(now())

  customer        User           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  requestedTailor TailorProfile? @relation("RequestedTailor", fields: [requestedTailorId], references: [id], onDelete: SetNull)
  photos          JobPhoto[]
  quotes          Quote[]
  booking         Booking?

  @@index([status, category])
  @@index([customerId])
}

model JobPhoto {
  id        String   @id @default(cuid())
  jobId     String
  storageKey String  @unique
  mime      String
  bytes     Int
  createdAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model Quote {
  id         String      @id @default(cuid())
  jobId      String
  tailorId   String
  priceCents Int
  readyBy    DateTime
  message    String      @default("")
  // The tailor's pickup & delivery charge for this job (paid to the tailor, not tailor me).
  pickupFeeCents Int?
  status     QuoteStatus @default(PENDING)
  createdAt  DateTime    @default(now())

  job     Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tailor  TailorProfile @relation(fields: [tailorId], references: [id], onDelete: Cascade)
  booking Booking?

  @@unique([jobId, tailorId])
}

// Booking is free for customers (decided 9 Nov 2026). Each new (non-repeat) booking
// uses one of the tailor's monthly jobs; see src/lib/plans.ts.
model Booking {
  id                      String        @id @default(cuid())
  jobId                   String        @unique
  quoteId                 String        @unique
  customerId              String
  tailorId                String
  // Rebooking a tailor the customer had booked before: free for the customer,
  // and it doesn't use one of the tailor's monthly jobs.
  isRepeat                Boolean       @default(false)
  status                  BookingStatus @default(CONFIRMED)
  // When the customer accepted the quote. Bookings are free, so this is also when contact details are shared.
  bookedAt                DateTime      @default(now())
  completedAt             DateTime?
  createdAt               DateTime      @default(now())

  job      Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  quote    Quote         @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  customer User          @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Cascade)
  tailor   TailorProfile @relation(fields: [tailorId], references: [id], onDelete: Cascade)
  review   Review?
  reports  ConductReport[]
  fit      FitRecord?
}

// The customer's fit record: one entry per booking, written by that booking's
// tailor at the fitting. Belongs to the customer (they can delete it, not edit it)
// and is shown to every tailor they book through tailor me. See src/lib/fit.ts.
model FitRecord {
  id           String   @id @default(cuid())
  customerId   String
  tailorId     String
  bookingId    String   @unique
  garment      String
  // { inseam: 78.5, waist: 82, ... } in centimetres.
  measurements Json
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer User          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tailor   TailorProfile @relation(fields: [tailorId], references: [id], onDelete: Cascade)
  booking  Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
}


// A customer's report that a tailor arranged (or asked to arrange) work outside tailor me.
// Only customers with a paid booking with that tailor can report. An admin decides.
model ConductReport {
  id         String        @id @default(cuid())
  tailorId   String
  customerId String
  bookingId  String?
  details    String
  status     ReportStatus  @default(OPEN)
  adminNote  String?
  createdAt  DateTime      @default(now())
  resolvedAt DateTime?
  tailor     TailorProfile @relation(fields: [tailorId], references: [id], onDelete: Cascade)
  customer   User          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  booking    Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([tailorId])
}

// Reviews can only exist against a paid booking (rule 6). There is deliberately
// no update path anywhere in the app: nobody, including admins, edits a review.
model Review {
  id            String   @id @default(cuid())
  bookingId     String   @unique
  tailorId      String
  customerId    String
  rating        Int
  fitFinish     Int
  onTime        Int
  quoteAccuracy Int
  body          String
  createdAt     DateTime @default(now())

  booking  Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  tailor   TailorProfile @relation(fields: [tailorId], references: [id], onDelete: Cascade)
  customer User          @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tailorId])
}

model MyTailor {
  customerId String
  tailorId   String
  createdAt  DateTime      @default(now())
  customer   User          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tailor     TailorProfile @relation(fields: [tailorId], references: [id], onDelete: Cascade)

  @@id([customerId, tailorId])
}

// Extra jobs bought one-off when a tailor's plan runs out ($7 each, src/lib/plans.ts).
// They count only in the Sydney month they were bought (`month`, e.g. "2026-11").
model ExtraJobsPurchase {
  id              String         @id @default(cuid())
  tailorId        String
  jobs            Int
  amountCents     Int
  month           String
  status          PurchaseStatus @default(PENDING)
  stripeSessionId String?        @unique
  createdAt       DateTime       @default(now())
  paidAt          DateTime?

  tailor TailorProfile @relation(fields: [tailorId], references: [id], onDelete: Cascade)

  @@index([tailorId, month, status])
}
